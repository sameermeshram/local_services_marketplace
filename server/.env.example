PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/fixit_local
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=change_me_cookie_secret_min_32_chars
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=FixIt Local Admin
ADMIN_PHONE=0000000000
ADMIN_PINCODE=000000
ADMIN_PASSWORD=set_locally_before_running_seed
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
